rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth.uid == resource.data.uid;
    }

    match /Stores/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if resource.data.store_owner == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /Stores/{parent}/StoreCards/{document} {
      allow create: if request.auth != null;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/StoreCards/{document} {
      allow read: if true;
    }


    match /users/{parent}/UserCards/{document} {
      allow create: if request.auth != null;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/UserCards/{document} {
      allow read: if true;
    }


    match /FeatureSuggestion/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }

    match /Stores/{parent}/Redeemables/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if request.auth != null;
    }

    match /{path=**}/Redeemables/{document} {
      allow read: if true;
    }


    match /Stores/{parent}/Transactions/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/Transactions/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/UserTransactions/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/UserTransactions/{document} {
      allow read: if request.auth != null;
    }


    match /BusinessAccountDeleteRequest/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /Stores/{parent}/Branches/{document} {
      allow create: if request.auth != null;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/Branches/{document} {
      allow read: if true;
    }


    match /Stores/{parent}/StoreCatalog/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/StoreCatalog/{document} {
      allow read: if true;
    }


    match /PushNotificationHistory/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /Chat/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if /databases/$(database)/documents/users/$(request.auth.uid) in resource.data.participantsUserRef;
      allow delete: if false;
    }

    match /Chat/{parent}/ChatMessages/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if /databases/$(database)/documents/users/$(request.auth.uid) in get(/databases/$(database)/documents/Chat/$(parent)).data.participantsUserRef;
      allow delete: if false;
    }

    match /{path=**}/ChatMessages/{document} {
      allow read: if request.auth != null;
    }


    match /Stores/{parent}/Voucher/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/Voucher/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/UserVouchers/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /{path=**}/UserVouchers/{document} {
      allow read: if request.auth != null;
    }


    match /ff_user_push_notifications/{id} {
      allow read, update, delete: if false;
      allow create: if /databases/$(database)/documents/users/$(request.auth.uid) == request.resource.data.sender;
    }
  }
}
